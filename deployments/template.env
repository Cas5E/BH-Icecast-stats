# BH-Icecast — instance template
# Copy via: bash scripts/new-instance.sh --domain stream.example.com --email you@example.com
# Or: cp deployments/template.env deployments/stream.example.com.env

# Public DNS name for this server (A/AAAA → this host)
BH_DOMAIN=stream.example.com
ICECAST_HOSTNAME=stream.example.com

# Must match BH_DOMAIN (used in API listen_url responses)
BH_PUBLIC_LISTEN_BASE=https://stream.example.com

ICECAST_SOURCE_PASSWORD=CHANGE_ME_MASTER_SOURCE
ICECAST_RELAY_PASSWORD=CHANGE_ME_RELAY
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=CHANGE_ME_ADMIN
ICECAST_LOCATION=Amsterdam
ICECAST_ADMIN_EMAIL=info@broadcastone.nl

BH_API_TOKEN=CHANGE_ME_API_TOKEN

LETSENCRYPT_EMAIL=you@example.com

# Optional — used by deploy-instance.sh
# DEPLOY_SSH_HOST=203.0.113.10
# DEPLOY_SSH_USER=root
# DEPLOY_REMOTE_DIR=/opt/bh-icecast
