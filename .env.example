# Domain
BH_DOMAIN=icecast.ebbersbroadcast.technology
ICECAST_HOSTNAME=icecast.ebbersbroadcast.technology

ICECAST_SOURCE_PASSWORD=change-me-master-source
ICECAST_RELAY_PASSWORD=change-me-relay
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change-me-admin

# Public base URL used in API responses (listen_url)
BH_PUBLIC_LISTEN_BASE=https://icecast.ebbersbroadcast.technology

# Bearer token for management API
BH_API_TOKEN=change-me-api-token

# Comma-separated IPs allowed to reach /api /docs on :443 (in addition to localhost).
# Example: BH_API_ALLOW_IPS=203.0.113.10,198.51.100.20
# Leave empty = only localhost / SSH tunnel (127.0.0.1:8080).
BH_API_ALLOW_IPS=

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@ebbersbroadcast.technology
