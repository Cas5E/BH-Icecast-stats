# Generic placeholders — copy to deployments/<domain>.env via new-instance.sh
BH_DOMAIN=stream.example.com
ICECAST_HOSTNAME=stream.example.com
BH_PUBLIC_LISTEN_BASE=https://stream.example.com

ICECAST_SOURCE_PASSWORD=change-me-master-source
ICECAST_RELAY_PASSWORD=change-me-relay
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change-me-admin

BH_API_TOKEN=change-me-api-token

# Comma-separated IPs for /api and /docs on :443. Empty = SSH tunnel only.
BH_API_ALLOW_IPS=

LETSENCRYPT_EMAIL=admin@example.com
