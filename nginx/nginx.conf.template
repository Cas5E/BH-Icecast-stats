worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    tcp_nopush    on;
    tcp_nodelay   on;
    keepalive_timeout 65;
    server_tokens off;

    # Icecast SOURCE/PUT clients break on HTTP/2 — keep HTTP/1.1 only
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 7d;
    proxy_send_timeout 7d;
    client_max_body_size 0;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      "";
    }

    map $request_method $bh_upstream_authorization {
        default "Basic ${ICECAST_SOURCE_AUTH_BASIC}";
        GET     "";
        HEAD    "";
    }

    map $request_method $bh_force_https {
        default 0;
        GET     1;
        HEAD    1;
    }

    upstream icecast {
        server icecast:8000;
        keepalive 32;
    }

    upstream api {
        server api:8080;
    }

    # --- Public HTTP :80 (ACME + source ingest + redirect listeners) ---
    server {
        listen 80;
        listen [::]:80;
        server_name ${BH_DOMAIN};

        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location = /_bh_source_auth {
            internal;
            proxy_pass http://api/internal/source-auth;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Original-Method $request_method;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location ^~ /admin {
            return 403;
        }

        # Management API is never on :80
        location ^~ /api/ { return 404; }
        location ^~ /docs { return 404; }
        location ^~ /redoc { return 404; }
        location = /openapi.json { return 404; }
        location = /health { return 404; }

        location / {
            if ($bh_force_https = 1) {
                return 301 https://$host$request_uri;
            }
            auth_request /_bh_source_auth;
            proxy_set_header Authorization $bh_upstream_authorization;
            proxy_pass http://icecast;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }
    }

    # --- Public HTTPS :443 (streams public, API IP-restricted) ---
    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name ${BH_DOMAIN};

        ssl_certificate     ${SSL_CERTIFICATE};
        ssl_certificate_key ${SSL_CERTIFICATE_KEY};
        ssl_session_timeout 1d;
        ssl_session_cache shared:SSL:10m;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        # Private management — only BH_API_ALLOW_IPS (+ localhost)
        location ^~ /api/ {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /health {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api/health;
            proxy_set_header Host $host;
        }

        location ^~ /docs {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }

        location ^~ /redoc {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /openapi.json {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api/openapi.json;
            proxy_set_header Host $host;
        }

        location ^~ /internal/ {
            return 404;
        }

        location ^~ /admin {
            return 403;
        }

        location = /_bh_source_auth {
            internal;
            proxy_pass http://api/internal/source-auth;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Original-Method $request_method;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # Public Icecast streams
        location / {
            auth_request /_bh_source_auth;
            proxy_set_header Authorization $bh_upstream_authorization;
            proxy_pass http://icecast;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
        }
    }

    # --- Local-only management (SSH tunnel: ssh -L 8080:127.0.0.1:8080 root@server) ---
    server {
        listen 127.0.0.1:8080;
        server_name _;

        location / {
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto http;
        }
    }
}
