worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    tcp_nopush    on;
    tcp_nodelay   on;
    server_tokens off;

    keepalive_timeout 7d;
    client_header_timeout 7d;
    client_body_timeout 7d;
    send_timeout 7d;
    client_max_body_size 0;

    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_max_temp_file_size 0;
    proxy_connect_timeout 60s;
    proxy_read_timeout 7d;
    proxy_send_timeout 7d;
    proxy_socket_keepalive on;

    map $request_method $bh_force_https {
        default 0;
        GET     1;
        HEAD    1;
    }

    upstream icecast {
        server icecast:8000;
    }

    upstream api {
        server api:8080;
        keepalive 8;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name ${BH_DOMAIN};

        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location ^~ /admin { return 403; }
        location ^~ /api/ { return 404; }
        location ^~ /docs { return 404; }
        location ^~ /redoc { return 404; }
        location = /openapi.json { return 404; }
        location = /health { return 404; }

        location / {
            # Listeners -> HTTPS
            if ($bh_force_https = 1) {
                return 301 https://$host$request_uri;
            }
            # Encoders must use Icecast :8000 (nginx SOURCE proxy is unstable)
            default_type text/plain;
            return 403 "Encode to port 8000 (Icecast), not port 80.\n";
        }
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name ${BH_DOMAIN};

        ssl_certificate     ${SSL_CERTIFICATE};
        ssl_certificate_key ${SSL_CERTIFICATE_KEY};
        ssl_session_timeout 1d;
        ssl_session_cache shared:SSL:10m;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        location ^~ /api/ {
            include /etc/nginx/bh_api_allow.conf;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /health {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api/health;
            proxy_set_header Host $host;
        }

        location ^~ /docs {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }

        location ^~ /redoc {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /openapi.json {
            include /etc/nginx/bh_api_allow.conf;
            proxy_pass http://api/openapi.json;
            proxy_set_header Host $host;
        }

        location ^~ /internal/ { return 404; }
        location ^~ /admin { return 403; }

        # Listeners + status only (GET/HEAD)
        location / {
            if ($request_method !~ ^(GET|HEAD)$) {
                return 403 "Encode to port 8000 (Icecast), not 443.\n";
            }
            proxy_set_header Connection "close";
            proxy_pass http://icecast;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_ignore_client_abort off;
        }
    }

    server {
        listen 127.0.0.1:8080;
        server_name _;

        location / {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto http;
        }
    }
}
